{
  "name": "PIGIN",
  "short_name": "PIGIN",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "categories": ["social"],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "background_color": "#f6f7f3",
  "theme_color": "#f6f7f3",
  "icons": [
    {
      "src": "/static/icon-192.png?v=pigin-logo",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icon-512.png?v=pigin-logo",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
